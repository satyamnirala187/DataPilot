# Backend settings. Copy to .env in the project root for local development; never commit .env.
# In production these are set in the Render dashboard (see docs/deployment.md).

# Read-only role used for every user query. Use the Supabase session pooler (IPv4). The app and the
# setup scripts always require TLS (sslmode=require), even if a URL leaves sslmode out.
READONLY_DATABASE_URL=postgresql://datapilot_readonly.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Role datapilot_app, for History and Saved Reports only (schema datapilot). Written to .env by
# database/create_app_role.py. Not used by any code yet; never used for generated SQL.
# APP_DATABASE_URL=postgresql://datapilot_app.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Admin connection for the setup scripts in database/ ONLY. Never set it on Render.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

GEMINI_API_KEY=<your-gemini-api-key>

# Private demo access (login gate). Set all three secrets to enable login; until then login is
# unavailable and POST /query refuses every request. Never commit real values.
# DEMO_USERNAME=<set-in-production>
# DEMO_PASSWORD=<set-in-production>         # at least 16 characters
# DEMO_SESSION_SECRET=<set-in-production>   # at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# DEMO_SESSION_MINUTES=120

# Optional (defaults shown).
# GEMINI_MODEL=gemini-3.6-flash
# ENABLE_API_DOCS=false         # true locally to serve /docs, /redoc and /openapi.json
# CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# RATE_LIMIT_REQUESTS=5
# TRUST_CF_CONNECTING_IP=false   # true only behind Cloudflare (Render); see docs/deployment.md
# RATE_LIMIT_WINDOW_SECONDS=60
# GLOBAL_DAILY_QUERY_LIMIT=5     # questions per Pacific day from all clients together
# QUERY_TIMEOUT_MS=5000
# MAX_RESULT_ROWS=500
# MAX_RESULT_BYTES=1000000      # largest answer (JSON of columns + rows) DataPilot returns
