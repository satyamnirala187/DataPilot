# Backend settings. Copy to .env in the project root for local development; never commit .env.
# In production these are set in the Render dashboard (see docs/deployment.md).

# Read-only role used for every user query. Use the Supabase session pooler (IPv4) and require SSL.
READONLY_DATABASE_URL=postgresql://datapilot_readonly.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Admin connection for the setup scripts in database/ ONLY. Never set it on Render.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

GEMINI_API_KEY=<your-gemini-api-key>

# Optional (defaults shown).
# GEMINI_MODEL=gemini-3.8-flash
# CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# RATE_LIMIT_REQUESTS=5
# TRUST_CF_CONNECTING_IP=false   # true only behind Cloudflare (Render); see docs/deployment.md
# RATE_LIMIT_WINDOW_SECONDS=60
# QUERY_TIMEOUT_MS=5000
# MAX_RESULT_ROWS=500
